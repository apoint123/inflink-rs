{
	"name": "inflink-rs-workspace",
	"private": true,
	"type": "module",
	"version": "3.4.0",
	"license": "GPL-3.0-only",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "cd packages/frontend && vite build",
		"dev": "cd packages/frontend && vite build --watch --mode development",
		"build:frontend": "cd packages/frontend && vite build --mode frontend-only",
		"lint": "biome check . --error-on-warnings",
		"format": "biome format . --write",
		"typecheck": "tsc -b && tsc -p scripts/tsconfig.json",
		"prepare": "husky",
		"cs:add": "changeset add",
		"cs:version": "changeset version && node ./scripts/sync-versions.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@changesets/cli": "^3.0.0",
		"@changesets/types": "^7.0.0",
		"@types/node": "^26.6.3",
		"husky": "^9.1.7",
		"typescript": "^7.0.2",
		"vite": "^8.0.8",
		"vite-plugin-css-injected-by-js": "^5.0.0"
	}
}
